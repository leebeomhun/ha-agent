[Unit]
Description=HA 집 비서 (규칙 감시 + 다중 AI 판단 + Assist 서버)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/ha-agent
ExecStart=/usr/bin/env node /home/ubuntu/ha-agent/src/main.mjs
Environment=PATH=/home/ubuntu/.local/bin:/home/ubuntu/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
# 대화 기록·집 상태가 든 DB·로그를 다른 사용자가 읽지 못하게 새로 만드는 파일은 소유자 전용(600/700)으로 만든다.
UMask=0077
RestartSec=15
TimeoutStopSec=15
MemoryMax=512M

[Install]
WantedBy=default.target
