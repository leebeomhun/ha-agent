{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "notifications",
    "rule_changes",
    "next_wakes",
    "memory",
    "memory_ops",
    "lesson_ops",
    "info_requests",
    "actions",
    "proposals",
    "report"
  ],
  "properties": {
    "summary": {
      "type": "string",
      "description": "이번 판단 요약(기록용, 한두 문장)"
    },
    "notifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "level",
          "title",
          "message",
          "related_rule_ids"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "alert",
              "info",
              "hourly_summary"
            ]
          },
          "level": {
            "type": "string",
            "enum": [
              "urgent",
              "normal",
              "quiet"
            ]
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "related_rule_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "rule_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "upsert",
        "delete"
      ],
      "properties": {
        "upsert": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "description",
              "entity_id",
              "attribute",
              "op",
              "value",
              "for_minutes",
              "cooldown_minutes",
              "priority",
              "also",
              "hour_from",
              "hour_to"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "entity_id": {
                "type": "string"
              },
              "attribute": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "op": {
                "type": "string",
                "enum": [
                  "eq",
                  "ne",
                  "in",
                  "not_in",
                  "gt",
                  "lt",
                  "unavailable",
                  "stale",
                  "changes_gt",
                  "rise_gt",
                  "drop_gt",
                  "older_than"
                ]
              },
              "value": {
                "type": [
                  "string",
                  "number",
                  "null"
                ]
              },
              "for_minutes": {
                "type": "number"
              },
              "cooldown_minutes": {
                "type": "number"
              },
              "priority": {
                "type": "string",
                "enum": [
                  "urgent",
                  "normal"
                ]
              },
              "also": {
                "type": "array",
                "description": "함께 참이어야 하는 다른 조건(3개까지). 없으면 빈 배열",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "entity_id",
                    "attribute",
                    "op",
                    "value"
                  ],
                  "properties": {
                    "entity_id": {
                      "type": "string"
                    },
                    "attribute": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "op": {
                      "type": "string",
                      "enum": [
                        "eq",
                        "ne",
                        "in",
                        "not_in",
                        "gt",
                        "lt",
                        "unavailable",
                        "older_than"
                      ]
                    },
                    "value": {
                      "type": [
                        "string",
                        "number",
                        "null"
                      ]
                    }
                  }
                }
              },
              "hour_from": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "이 시각(KST 0~23)부터만 본다. 시간대 제한이 없으면 null"
              },
              "hour_to": {
                "type": [
                  "integer",
                  "null"
                ],
                "description": "이 시각(KST 0~24) 전까지만 본다. 시간대 제한이 없으면 null"
              }
            }
          }
        },
        "delete": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_wakes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "reason"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "text"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "keep",
            "append",
            "replace"
          ]
        },
        "text": {
          "type": "string"
        }
      }
    },
    "memory_ops": {
      "type": "array",
      "description": "구조화 장기 기억 추가·수정·삭제. 없으면 빈 배열",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "category",
          "key",
          "content",
          "ttl_days",
          "confidence",
          "pinned",
          "entity_ids"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "upsert",
              "delete"
            ]
          },
          "category": {
            "type": "string",
            "enum": [
              "preference",
              "standing_order",
              "incident",
              "pattern",
              "rejection"
            ]
          },
          "key": {
            "type": "string"
          },
          "content": {
            "type": "string"
          },
          "ttl_days": {
            "type": [
              "integer",
              "null"
            ],
            "description": "만료 일수(양수). 0 또는 null이면 카테고리 기본 정책(standing_order/preference 무기한, incident 21일)"
          },
          "confidence": {
            "type": [
              "number",
              "null"
            ],
            "description": "확신도 0~1. null이면 1.0"
          },
          "pinned": {
            "type": [
              "boolean",
              "null"
            ],
            "description": "영구 고정 여부(true면 자동 삭제·만료 차단, 프롬프트 최우선 배치). null이면 기존 유지"
          },
          "entity_ids": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "연관 엔티티 ID 목록(맥락 기반 회상용). 없으면 null"
          }
        }
      }
    },
    "lesson_ops": {
      "type": "array",
      "description": "절차적 교훈(Playbook: 반복 실패에서 얻은 행동 원칙) 추가·수정·삭제. 없으면 빈 배열",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "op",
          "key",
          "scope",
          "condition_text",
          "rule_text",
          "evidence",
          "pinned"
        ],
        "properties": {
          "op": {
            "type": "string",
            "enum": [
              "upsert",
              "delete"
            ]
          },
          "key": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "all",
              "assist",
              "cycle",
              "weekly",
              "proposal"
            ]
          },
          "condition_text": {
            "type": "string",
            "description": "적용 상황(When)"
          },
          "rule_text": {
            "type": "string",
            "description": "지켜야 할 행동 원칙(Rule)"
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ],
            "description": "근거 사례 요약. 없으면 null"
          },
          "pinned": {
            "type": [
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "info_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "entity_ids",
          "hours"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "history",
              "statistics",
              "logbook",
              "traces",
              "config_entries"
            ]
          },
          "entity_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hours": {
            "type": "number"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "기기 제어. 행동 권한에 적힌 엔티티만. 없으면 빈 배열",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "action",
          "service_data_json",
          "reason",
          "requested"
        ],
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "action": {
            "type": "string",
            "enum": [
              "turn_on",
              "turn_off",
              "set_percentage",
              "set_preset_mode",
              "set_humidity",
              "set_mode",
              "set_temperature",
              "set_hvac_mode",
              "open_cover",
              "close_cover",
              "stop_cover",
              "set_cover_position",
              "media_pause",
              "media_play",
              "media_stop",
              "volume_set",
              "volume_mute",
              "select_source",
              "select_option",
              "set_value",
              "set_datetime",
              "start",
              "pause",
              "return_to_base"
            ]
          },
          "service_data_json": {
            "type": [
              "string",
              "null"
            ],
            "description": "추가 파라미터 JSON 문자열(예: {\"option\":\"turbo\"} 또는 {\"brightness_pct\":50}). 필요 없으면 null"
          },
          "reason": {
            "type": "string",
            "description": "사용자에게 보여줄 이유(한국어, 한 문장)"
          },
          "requested": {
            "type": "boolean",
            "description": "깨운 이유가 [사용자 말]이고 사용자가 그 말에서 직접 시킨 행동이면 true(승인을 다시 묻지 않고 바로 실행). 스스로 판단한 행동은 false"
          }
        }
      }
    },
    "proposals": {
      "type": "array",
      "description": "HA 관리 변경 제안(Tier 2 사용자 승인 필요). 없으면 빈 배열",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "target_id",
          "title",
          "summary",
          "payload_json"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "automation_upsert",
              "automation_delete",
              "automation_toggle",
              "script_upsert",
              "script_delete",
              "reload_config_entry",
              "backup_create",
              "entity_admin",
              "promote_rule",
              "self_alias_proposal",
              "self_noise_proposal",
              "self_stt_tune",
              "self_lesson_proposal"
            ]
          },
          "target_id": {
            "type": "string",
            "description": "대상 entity_id 또는 config_entry_id 또는 rule_id"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "payload_json": {
            "type": [
              "string",
              "null"
            ],
            "description": "설정·파라미터 JSON 문자열. 필요 없으면 null"
          }
        }
      }
    },
    "report": {
      "type": "string",
      "description": "주간 분석 보고서(마크다운). 주간 분석(weekly) 깨움에서만 쓰고 그 밖에는 빈 문자열"
    }
  }
}
